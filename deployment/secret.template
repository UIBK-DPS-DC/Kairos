---
# Secret: Onedata and Airflow credentials — TEMPLATE
#
# Copy this file to secret.yaml and fill in the real values.
# secret.yaml is excluded from git via .gitignore.
#
apiVersion: v1
kind: Secret
metadata:
  name: predictor-secrets
  namespace: default   # Change if deploying to a different namespace
  labels:
    app: predictor
    component: config
type: Opaque
stringData:
  # ── Onedata ─────────────────────────────────────────────────────────────
  # Space to monitor/manage (get from Onezone UI → Spaces)
  space-id: "<ONEDATA_SPACE_ID>"

  # REST access token with provider-level access (Onezone UI → Tokens)
  token-provider: "<ONEDATA_TOKEN_PROVIDER>"

  # REST access token with zone-level access
  token-zone: "<ONEDATA_TOKEN_ZONE>"

  # ID of the DevNull / network-monitoring space used for latency probing
  devnull-space-id: "<DEVNULL_SPACE_ID>"

  # ── Airflow ──────────────────────────────────────────────────────────────
  # Airflow UI credentials
  airflow-username: "<AIRFLOW_USERNAME>"
  airflow-password: "<AIRFLOW_PASSWORD>"

  # Base URL of the Airflow API server, with scheme and port
  # Find the service with: kubectl get svc | grep airflow
  airflow-api-service: "http://<airflow-api-service-name>:8080"
