---
# ServiceAccount + Role + RoleBinding for the predictor Job — TEMPLATE
#
# Copy to serviceaccount.yaml. No sensitive values here; this file is
# safe to commit as-is, but a template is provided for namespace
# customisation.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: predictor
  namespace: default   # Change if deploying to a different namespace
  labels:
    app: predictor
---
# Role: minimal RBAC — read Secrets, read pod logs
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: predictor
  namespace: default
  labels:
    app: predictor
rules:
- apiGroups: [""]
  resources: ["secrets"]
  verbs: ["get", "list"]
- apiGroups: [""]
  resources: ["pods/log"]
  verbs: ["get", "list"]
---
# RoleBinding: attach Role to ServiceAccount
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: predictor
  namespace: default
  labels:
    app: predictor
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: predictor
subjects:
- kind: ServiceAccount
  name: predictor
  namespace: default

